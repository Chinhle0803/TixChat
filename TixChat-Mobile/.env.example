# IMPORTANT:
# - Android emulator with `adb reverse tcp:5000 tcp:5000`: you can use 127.0.0.1
# - Physical device in Expo dev: app will try to replace localhost/127.0.0.1 with the current Metro host automatically
# - Production / remote backend: set your real backend domain directly
EXPO_PUBLIC_API_URL=http://127.0.0.1:5000/api
EXPO_PUBLIC_SOCKET_URL=http://127.0.0.1:5000
