NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

DYNAMODB_USERS_TABLE=Users
DYNAMODB_CONVERSATIONS_TABLE=Conversations
DYNAMODB_MESSAGES_TABLE=Messages
DYNAMODB_PARTICIPANTS_TABLE=Participants
DYNAMODB_CALL_SESSIONS_TABLE=tixchat-call-sessions
DYNAMODB_NOTIFICATION_TOKENS_TABLE=tixchat-notification-tokens
DYNAMODB_POSTS_TABLE=tixchat-posts
DYNAMODB_COMMENTS_TABLE=tixchat-comments
DYNAMODB_URBAN_STATS_TABLE=tixchat-urban-incident-stats

AWS_LOCATION_REGION=ap-southeast-1
AWS_LOCATION_STYLE=Standard
AWS_LOCATION_COLOR_SCHEME=Light
AWS_LOCATION_VARIANT=Default
AWS_LOCATION_ALLOWED_IPS=

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d 

AWS_SES_REGION=ap-southeast-2
AWS_SES_SENDER_EMAIL=

AWS_S3_REGION=
S3_BUCKET_NAME=
S3_AVATAR_FOLDER=
S3_MESSAGE_FOLDER=messages
S3_POST_IMAGES_BUCKET=
S3_POST_IMAGES_FOLDER=urban-posts

AWS_CHIME_REGION=ap-southeast-1
CHIME_MEETING_REGION=ap-southeast-1
CALL_RING_TIMEOUT_SECONDS=60

FRONTEND_URL=http://localhost:5173

REDIS_URL=redis://redis:6379
REDIS_ENABLED=false
REDIS_KEY_PREFIX=tixchat
REDIS_CONNECT_TIMEOUT_MS=1500
REDIS_DEFAULT_TTL_SECONDS=60
REDIS_POST_TTL_SECONDS=30
REDIS_USER_TTL_SECONDS=120
